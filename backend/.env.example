FLASK_ENV=development
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# utf8mb4 es obligatorio: sin el 4 se rompen la ñ y los acentos
DATABASE_URL=mysql+pymysql://usuario:password@localhost/ventanilla?charset=utf8mb4

# Dónde viven los archivos subidos.
#   local → disco. Solo para desarrollo: el disco de los servidores gratuitos
#           es efímero y lo subido desaparece en cada reinicio.
#   s3    → almacenamiento de objetos (Cloudflare R2, Backblaze B2).
ALMACENAMIENTO=local

# Con ALMACENAMIENTO=local. Carpeta fuera del directorio público: los
# comprobantes llevan datos bancarios.
RUTA_ARCHIVOS=/var/ventanilla/archivos

# Con ALMACENAMIENTO=s3. En Cloudflare R2 el endpoint es
# https://<id-de-cuenta>.r2.cloudflarestorage.com y la región es "auto".
S3_ENDPOINT=
S3_CLAVE=
S3_SECRETO=
S3_BUCKET=
S3_REGION=auto
TAMANIO_MAX_MB=5

FRONTEND_ORIGIN=http://localhost:5173
URL_PUBLICA=http://localhost:5173

# Sin SMTP_HOST los correos se escriben al log en lugar de enviarse: sirve para
# probar el flujo completo sin depender del servidor de correo.
#
# Gmail: smtp.gmail.com puerto 587. La contraseña normal NO funciona; hace
# falta una "contraseña de aplicación", que solo aparece con la verificación
# en dos pasos activada en la cuenta.
#
# Microsoft 365 / Outlook: smtp.office365.com puerto 587. Puede fallar con
# "SmtpClientAuthentication is disabled for the Mailbox": la autenticación
# básica está en retirada y muchos buzones la traen deshabilitada.
#
# Ninguna de las dos es la solución definitiva: para producción hay que pedir
# a la UV un relevo SMTP institucional y una dirección del dominio uv.mx.
# El puerto decide el protocolo: 587 usa STARTTLS, 465 usa SSL directo.
# Si en tu red uno se queda esperando hasta el timeout, prueba el otro.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_TIMEOUT=20
SMTP_USUARIO=
SMTP_PASSWORD=
CORREO_REMITENTE=ventanilla@uv.mx
